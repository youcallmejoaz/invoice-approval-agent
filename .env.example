# Demo mode: 1 = run with zero API keys using recorded/simulated model responses in fixtures/.
# 0 = call Claude for real (needs ANTHROPIC_API_KEY).
DEMO_MODE=1

# Only needed when DEMO_MODE=0. Never commit a real key.
ANTHROPIC_API_KEY=

# Models used for extraction (fast first pass, then re-check of low-confidence fields).
EXTRACT_MODEL_FAST=claude-haiku-5-5
EXTRACT_MODEL_CHECK=claude-sonnet-5-5

# Fields below this confidence (0 to 1) are re-checked by the bigger model, and go to a person if still below.
CONFIDENCE_THRESHOLD=0.85

# Where the database, stored invoice files, watched folder and mock inbox live.
DATA_DIR=./data

# Accounting system to post approved bills to: mock | zoho | xero
ACCOUNTING_ADAPTER=mock

# Zoho Books (stub, see src/lib/accounting/zoho.ts). Needed only when ACCOUNTING_ADAPTER=zoho.
ZOHO_ORGANIZATION_ID=
ZOHO_ACCESS_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.com

# Xero (stub, see src/lib/accounting/xero.ts). Needed only when ACCOUNTING_ADAPTER=xero.
XERO_TENANT_ID=
XERO_ACCESS_TOKEN=

# Mock email inbox: folder of .eml files the intake worker reads. A real IMAP mailbox is documented in src/lib/intake/imap.ts.
INBOX_DIR=./data/inbox
# How often the intake worker checks the watched folder and inbox, in milliseconds.
INTAKE_POLL_MS=2000
